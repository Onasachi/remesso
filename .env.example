# ---------------------------------------------------------------------------
# Celo (mainnet)
# ---------------------------------------------------------------------------
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Verified on-chain 2026-09-07. Do not edit without re-verifying with `cast code`.
CNGN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f   # 6 decimals
USDT_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e   # 6 decimals - the funding asset
UNISWAP_V3_ROUTER=0x5615CDAb10dc425a742d643d949a7F474C01abc4
UNISWAP_V3_QUOTER=0x82825d0554fA07f7FC52Ab63c961F330fdEFa8E8
UNISWAP_V3_FACTORY=0xAfE208a311B21f13EF87E33A90049fC17A7acDEc
CNGN_USDT_POOL=0x6519d56eb0a69fc0338657784c783b169b8f7d32
POOL_FEE_TIER=100

# Celo Sepolia testnet (run the contract here before mainnet)
# CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# CELO_CHAIN_ID=11142220
# CNGN_ADDRESS=0xa188439ccCEe9A6aa0E842f9c17C1b00C7B4dd4D

REMESSO_EXECUTOR_ADDRESS=
# Backend hot key. Can ONLY call executeRun(). Cannot alter any schedule policy.
EXECUTOR_PRIVATE_KEY=
CELOSCAN_API_KEY=

# ---------------------------------------------------------------------------
# cNGN API  (docs.cngn.co)
#
# All four values come from Settings -> API Key in the merchant dashboard, and
# every environment has its own set. See README "Getting cNGN credentials".
# ---------------------------------------------------------------------------
CNGN_API_BASE=https://api.cngn.co/v1/api

# cngn_test_... in sandbox, cngn_live_... in production. The prefix picks the
# environment; there is no separate base URL. Live keys are only issued after
# KYB onboarding is approved.
CNGN_API_KEY=

# AES-256-CBC request encryption. SHA-256'd to derive the 32-byte key. Shown
# next to the API key in the dashboard.
CNGN_ENCRYPTION_KEY=

# OpenSSH Ed25519 PRIVATE key. Generate with:
#     ssh-keygen -t ed25519 -C "api@remesso" -f cngn_api_key
# Upload cngn_api_key.pub to the dashboard and put the private half here.
#
# Do NOT set a passphrase. The docs offer one, but this runs unattended and has
# nothing to prompt with; a passphrase encrypts the key body and the private
# key cannot be loaded. Already set one? Strip it without changing the public
# key, so the dashboard needs no update:
#     ssh-keygen -p -N "" -f cngn_api_key
# Every response's `data` field is sealed to the public key, so without this
# nothing the API returns is readable — and requests fail outright with
# "No Test SSH Key found". Newlines may be escaped as \n.
CNGN_SSH_PRIVATE_KEY=

# Shared secret configured in the cNGN merchant dashboard; signs inbound
# webhooks as `X-cNGN-Signature: sha256=<hex>` over the raw body.
CNGN_WEBHOOK_SECRET=

# cNGN rejects requests from non-whitelisted source IPs with 403 regardless of
# credentials, and Supabase Edge Functions do not have a stable egress IP.
# Set this to a fixed-IP forward proxy and whitelist that IP instead.
# See README "cNGN egress: the IP whitelist problem".
CNGN_EGRESS_PROXY_URL=

# ---------------------------------------------------------------------------
# Self identity verification  (docs.self.xyz, dashboard.self.xyz)
#
# Optional. Leave SELF_API_KEY blank and the verify card never appears; nothing
# else changes, because no payment path reads the result.
#
# Dashboard: create a Pre-KYC flow (OFAC on, minimum age 18), deploy it, and
# copy its flowId. Test and Live each have their own flow id, API key and
# webhook secret — keep all three from the same tab.
# ---------------------------------------------------------------------------
# sk_test_... accepts the Self app's mock passports; sk_live_... needs a real one.
SELF_API_KEY=
SELF_FLOW_ID=
# Generated by Self (whsec_...) when you add the endpoint
#   https://<project>.supabase.co/functions/v1/self-webhook
# under Developer -> Webhooks. Not a value you choose.
SELF_WEBHOOK_SECRET=

# The web app's origin, e.g. https://remesso.app. Self sends the sender back
# here after verifying, and the proxy functions use it for CORS. Blank means
# CORS "*" and no return link.
WEB_ORIGIN=

# ---------------------------------------------------------------------------
# TypeSafe / Jev  (docs.typesafe.ai)
#
# Optional. Typed judgments, not generated text: a failure reason becomes one
# of OUR categories, a draft gets a second reading, and a schedule unlike the
# sender's usual gets a line above the signature. Leave blank and all three
# degrade to what they did before — rules-only classification, no doubt flags,
# no unusual line. Nothing on the money path reads any of it.
#
# Key from the TypeSafe dashboard.
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Celo attribution (ERC-8021)
#
# Appended after the calldata of every transaction this app causes, so Celo can
# trace it back to Remesso. Invisible to the contract; feeds ecosystem reward
# distribution, and untagged transactions cannot be claimed retroactively.
#
# Comma-separated; every code rides on every transaction. `remesso` is the
# app's own history; `celo_5cd35ca55baf` is the code Loops issued for the
# Agents on Open Rails hackathon, which credits only that one. The frontend
# uses the same list (NEXT_PUBLIC_ATTRIBUTION_CODE) so one app has one
# history. Charset [a-z0-9_] per code.
ATTRIBUTION_CODE=remesso,celo_5cd35ca55baf

# ---------------------------------------------------------------------------
# x402 — paid triggering (x402.celo.org)
#
# Optional. With these set, `trigger-run` sells one early send of a schedule
# for USDC over HTTP 402: an agent pays, one run fires ahead of its cadence,
# and nothing else about the schedule can be influenced. Unset, the endpoint
# answers 503 and the cadence is the only thing that runs a schedule.
#
# Key from https://x402.celo.org — connect a wallet, sign (no gas), copy once.
X402_API_KEY=
# Where payments land. The treasury, never the hot executor key.
X402_PAY_TO=
# Price per call in USDC base units (6dp). 10000 = $0.01.
X402_PRICE_UNITS=10000
# X402_FACILITATOR=https://api.x402.celo.org

# No longer read (2026-10-16): `trigger-run` and the Direct allowlist use
# REMESSO_EXECUTOR_ADDRESS, now that one contract does both. Safe to delete.
# REMESSO_EXECUTOR_V4_ADDRESS=

# ---------------------------------------------------------------------------
# Agent spending — Remesso paying other agents over x402
#
# Optional. Unset, Remesso can be paid but cannot pay: `payAndCall` refuses and
# nothing else changes.
#
# A SEPARATE key from EXECUTOR_PRIVATE_KEY, on purpose. The executor signs runs
# against other people's mandates; this one spends our own money. One key doing
# both is one compromise with two blast radii. Fund it with USDC only — EIP-3009
# means the facilitator pays the gas.
AGENT_SPEND_PRIVATE_KEY=

# Ceilings in USDC base units (6dp). Both are enforced before anything is
# signed, and the daily one is computed from the agent_spend ledger.
AGENT_MAX_PER_CALL_UNITS=50000    # $0.05
AGENT_MAX_PER_DAY_UNITS=1000000   # $1.00

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Guard rails enforced in the backend, above the on-chain envelope
MAX_SLIPPAGE_BPS=100
MAX_RUN_AMOUNT_USDT=1000

# ---------------------------------------------------------------------------
# DeepSeek  (the assistant layer)
#
# Advisory only, and deliberately so. Nothing the model returns can move money:
# it drafts a schedule the sender reviews and signs, and it rewrites failure
# reasons into plain language. The executor loop stays deterministic — pg_cron,
# `runnability()` and the sender's on-chain envelope decide what actually pays.
#
# Get a key at https://platform.deepseek.com -> API keys. Starts with `sk-`.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional overrides. The defaults target DeepSeek's own endpoint and its
# general chat model; both speak the OpenAI chat-completions dialect.
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
