# secrets
.env
.env.*
!.env.example

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# contracts/lib/ is NOT ignored: forge install registers deps as git
# submodules, so they belong in the tree for reproducible builds.

# node / deno
node_modules/
.DS_Store

# next.js
web/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
.env.local
.env.local.*
!web/.env.local.example
# The Vercel variable list. Documentation, not secrets: the one sensitive-
# looking value in it, the Supabase anon key, is public by design and guarded
# by row-level security.
!web/.env.production.example

# editor
.vscode/

# audit tooling scratch: per-agent bundles and a flattened source dump,
# regenerated on every run and not source of truth for anything.
.audit-*/

# supabase
supabase/.branches/
supabase/.temp/

# Skills installed with `npx skills add`. `skills-lock.json` pins each source
# and its hash, so this is restorable install output — 600K of someone else's
# repo that would otherwise land in ours. `.claude/skills/` is symlinks into it.
.agents/
.claude/skills/

# Left behind by running a Deno script inside the npm workspace. The web app
# has no Deno dependencies; this is not its lockfile.
web/deno.lock

# solidity-auditor scan output: per-scan runs and the findings ledger.
.solidity-auditor/
