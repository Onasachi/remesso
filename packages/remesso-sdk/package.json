{
  "name": "remesso-sdk",
  "version": "0.2.0",
  "description": "Recurring and agent payments on Celo: schedules a payer signs once, agent payments capped on-chain by their human, payment requests, payment events and signed webhooks. TypeScript, on viem.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "viem": "2.57.7"
  },
  "keywords": [
    "celo",
    "stablecoins",
    "payments",
    "recurring-payments",
    "agents",
    "webhooks",
    "viem",
    "remittances"
  ],
  "author": "Cracked Studio (https://bitbucket.org/crackedstudios)",
  "homepage": "https://remesso.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/crackedstudios/remesso.git",
    "directory": "packages/remesso-sdk"
  },
  "bugs": "https://bitbucket.org/crackedstudios/remesso/issues",
  "license": "MIT"
}
