{
  "name": "remesso",
  "version": "0.4.0",
  "description": "Stablecoin payments on Celo for agents: an agent wallet whose spending is capped on-chain by its human, scheduled payments under a Remesso mandate, and x402 payments in USA₮, USDC or USDT.",
  "author": {
    "name": "Cracked Studio",
    "url": "https://bitbucket.org/crackedstudios"
  },
  "homepage": "https://remesso.xyz",
  "repository": "https://bitbucket.org/crackedstudios/remesso",
  "license": "MIT",
  "keywords": [
    "celo",
    "payments",
    "stablecoins",
    "x402",
    "remittances",
    "agents",
    "minipay"
  ],
  "mcpServers": {
    "remesso-wallet": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"
      ]
    },
    "remesso": {
      "type": "http",
      "url": "https://remesso.xyz/mcp"
    }
  },
  "documentationUrl": "https://bitbucket.org/crackedstudios/remesso/src/main/plugin/README.md",
  "supportUrl": "https://bitbucket.org/crackedstudios/remesso/issues",
  "privacyPolicyUrl": "https://bitbucket.org/crackedstudios/remesso/src/main/plugin/PRIVACY.md",
  "termsOfServiceUrl": "https://remesso.xyz/terms"
}
