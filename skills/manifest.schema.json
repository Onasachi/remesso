{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitbucket.org/crackedstudios/remesso/raw/main/skills/manifest.schema.json",
  "title": "Remesso skill manifest",
  "description": "Machine-readable companion to a SKILL.md. Either an index of skills (has `skills`) or one skill's manifest (has `skill` and, for paid services, `payment`). Payment terms are a snapshot of a live 402; the 402 is authoritative.",
  "type": "object",
  "required": ["manifestVersion"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "skill": {
      "type": "object",
      "required": ["entry", "url"],
      "properties": { "entry": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "install": { "type": "object" },
    "payment": {
      "type": "object",
      "required": ["protocol", "version", "network", "payTo", "assets"],
      "properties": {
        "protocol": { "const": "x402" },
        "version": { "type": "integer" },
        "scheme": { "type": "string" },
        "network": { "type": "string", "description": "CAIP-2, e.g. eip155:42220" },
        "payTo": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "facilitator": { "type": "string", "format": "uri" },
        "defaultAsset": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$", "description": "Address of the asset the skill pays in unless told otherwise; every listed asset is accepted." },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "address", "decimals", "eip712"],
            "properties": {
              "symbol": { "type": "string" },
              "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "decimals": { "type": "integer" },
              "transfer": {
                "enum": ["eip3009", "permit2"],
                "description": "How a payment in this asset settles: an EIP-3009 authorisation, or a Permit2 transfer with an EIP-2612 permit the facilitator sponsors."
              },
              "eip712": {
                "type": "object",
                "required": ["name", "version"],
                "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "endpoint", "method", "price"],
        "properties": {
          "name": { "type": "string" },
          "endpoint": { "type": "string", "format": "uri" },
          "method": { "enum": ["GET", "POST"] },
          "price": {
            "type": "object",
            "description": "The dollar price (`amount`, `decimals` 6), and the same price in each accepted asset's own base units under `assets`, keyed by address.",
            "required": ["amount", "decimals"],
            "properties": {
              "amount": { "type": "string", "pattern": "^[0-9]+$" },
              "decimals": { "type": "integer" },
              "usd": { "type": "number" },
              "assets": {
                "type": "object",
                "patternProperties": { "^0x[0-9a-fA-F]{40}$": { "type": "string", "pattern": "^[0-9]+$" } },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "skill"],
        "properties": {
          "name": { "type": "string" },
          "skill": { "type": "string", "format": "uri" },
          "manifest": { "type": "string", "format": "uri" },
          "install": { "type": "string" }
        }
      }
    }
  }
}
