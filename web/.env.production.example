# Vercel environment — the sender app only.
#
# Set these in Vercel → Project → Settings → Environment Variables, or with
# `vercel env add <KEY> production`. The project's Root Directory must be
# `web`, since this app is one workspace in a larger repo.
#
# WHAT DOES NOT BELONG HERE
#
# No cNGN key, no Self key, no TypeSafe key, no x402 key, no DeepSeek key, and
# above all no EXECUTOR_PRIVATE_KEY. Those live as Supabase secrets, reachable
# only from Edge Functions. The browser talks to route handlers, the handlers
# talk to Edge Functions, and that arrangement is also what gives cNGN a single
# IP to whitelist. Anything pasted here with a NEXT_PUBLIC_ prefix is compiled
# into JavaScript that every visitor downloads.
#
# The Supabase anon key IS meant to be public: row-level security is what
# protects the data, not the key.

# --- the app's own backend -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://engaboljiqudghvzmebq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read by the route handlers under app/api, server-side. Same two values; they
# are separate because a server file must not depend on a NEXT_PUBLIC_ name.
SUPABASE_URL=https://engaboljiqudghvzmebq.supabase.co
SUPABASE_ANON_KEY=

# --- chain -----------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_REMESSO_EXECUTOR_ADDRESS=0x3C357af3300f383Ea49B6D6ED8e084199a92bEd8
NEXT_PUBLIC_USDT_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e
NEXT_PUBLIC_CNGN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f

# --- what the sender can authorise -----------------------------------------
# Naira rails stay off until the regulatory question is answered. Anything
# other than "1" means stablecoin-only, and blank is the same as absent.
NEXT_PUBLIC_ENABLE_CNGN_RAILS=0
NEXT_PUBLIC_CNGN_REDEMPTION_ADDRESS=

# The five-minute cadence is a TEST affordance: a real remittance is never
# five minutes, and with a transfer count of 12 it drains an allowance within
# the hour. It must be absent or "0" in production.
NEXT_PUBLIC_TEST_INTERVALS=0

# --- optional --------------------------------------------------------------
# History appears seconds after a block instead of after the backend write.
# Without it the history is the database alone — slower, not broken.
NEXT_PUBLIC_GOLDSKY_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmub9zi745rtc01ts1xx66zy6/subgraphs/remesso-celo-celo/prod/gn

# Must match ATTRIBUTION_CODE (comma-separated) in the root .env — one app, one code, or the
# history splits in two on Celo's dashboard.
NEXT_PUBLIC_ATTRIBUTION_CODE=remesso,celo_5cd35ca55baf

# ---------------------------------------------------------------------------
# AFTER THE FIRST DEPLOY
#
# Set WEB_ORIGIN (root .env, then `supabase secrets set`) to the Vercel URL and
# redeploy the Edge Functions. It is the CORS origin for cngn-proxy, ai-assist
# and self-verify, and it is where Self returns a sender after verifying — on
# the old ngrok value they land on a tunnel that is no longer running.
# ---------------------------------------------------------------------------
